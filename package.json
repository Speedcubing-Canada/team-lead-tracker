{
  "name": "team-lead-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p functions/tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit --project functions",
    "test:watch": "vitest --project unit --project functions",
    "emulators": "FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase emulators:start",
    "deploy": "npm run build && npm run test && firebase deploy --only hosting",
    "deploy:functions": "npm --prefix functions run build && FUNCTIONS_DISCOVERY_TIMEOUT=60 firebase deploy --only functions",
    "test:int": "firebase emulators:exec --project demo-test --only auth,firestore,storage \"vitest run --project integration\"",
    "coverage": "vitest run --project unit --project functions --coverage"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@tanstack/react-query": "^5.104.5",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
