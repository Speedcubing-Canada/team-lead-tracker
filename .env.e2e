# `vite --mode e2e`: the emulators plus the fake WCA server in e2e/fakeWca.ts.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-e2e
VITE_FIREBASE_STORAGE_BUCKET=demo-e2e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo
VITE_WCA_ORIGIN=http://127.0.0.1:9300
VITE_WCA_CLIENT_ID=e2e
VITE_USE_EMULATORS=true
